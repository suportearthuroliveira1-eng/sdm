# Copie para .env.local e preencha. NUNCA commite valores.
# Supabase → Project Settings → API Keys / Data API
# URL e chave publishable já estão fixas em src/lib/public-config.ts (são públicas).
# Só preencha pra apontar pra OUTRO projeto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # chave "secret" (sb_secret_...) ou service_role antiga. SÓ servidor.
# Supabase → Connect → ORMs/Transaction pooler (porta 6543). Na Vercel use SEMPRE o pooler.
DATABASE_URL=
OPENAI_API_KEY=
TRACKING_API_KEY=
HUBLA_WEBHOOK_SECRET=
HOTMART_WEBHOOK_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
WHATSAPP_PROVIDER=log
WHATSAPP_API_KEY=
ACCESS_LINK_SECRET=                  # opcional: sem ele, deriva da chave secret do Supabase
APP_URL=                             # opcional na Vercel (usa o domínio de produção); obrigatório em domínio próprio
ADMIN_EMAIL=
