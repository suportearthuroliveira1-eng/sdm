    "@supabase/supabase-js": "^2.119.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "openai": "^7.50.0",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
